{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/kairos-client.py", "hook", "stop"],
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/kairos-client.py", "hook", "end"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
