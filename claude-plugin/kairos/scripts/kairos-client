#!/usr/bin/env python3
"""KAIROS 클라이언트 (Claude Code 플러그인 `kairos`의 본체 · decisions.md §97·§102).

에이전트 CLI 쪽에서 KAIROS와 말하는 **유일한 코드**다. 플러그인이 설치되면 Claude Code가
훅으로 이것을 부르고(`hook stop`·`hook end`), 슬래시 명령이 이것을 부른다(`status`·`replay`).
**클라이언트 기계에서 돈다** — 게이트웨이와 다른 호스트일 수 있으므로 인푸터 SDK가 아니라
HTTP를 쓰고, KAIROS 체크아웃 없이 이 파일 하나만 있어도 돌도록 표준 라이브러리만 쓴다.

**무엇을 보낼지를 센다(허용 목록).** 게이트웨이의 인증은 "닫을 것"을 세지만
(`gateway/__init__.py`) 여기는 반대다. 그쪽은 목록에 넣기를 잊으면 유출이고 여기는
잊으면 그 종류가 아카이브되지 않을 뿐인데, 반대로 하면 **터미널 입출력이 통째로
실려 간다**. 실측에서 그 자리에 GitHub 토큰과 평문 비밀번호가 있었다(2026-09-04).
그래서 사람이 실제로 친 프롬프트와 어시스턴트의 답변 텍스트만 보낸다. 도구 호출·
도구 결과·사고 블록·슬래시 명령 출력·bash 입출력은 전부 보내지 않는다.

**그래도 새는 것은 서버가 받는다.** 어시스턴트가 답변 본문에 토큰을 적으면 허용
목록으로는 걸러지지 않는다. 그것은 시크릿 스캔(추출기 §3.1)이 잡아 `sensitive`
표시 + 로컬 백엔드 강제 + MCP 반환 시 마스킹으로 처리한다. 두 겹이다.

**자동 보관은 기본이 아니다**(기획서 11-B-2 — 명시 요청만). 플러그인이 훅을 등록해도
`KAIROS_AUTO_ARCHIVE=1`이 없으면 `hook stop`은 아무것도 보내지 않는다. 명시 보관은
`/kairos:archive`(→ `replay --project`)다.

설정 (환경 변수 — 플러그인의 `.mcp.json`과 훅이 같은 이름을 읽는다)
------------------------------------------------------------------
  KAIROS_URL            기본 http://127.0.0.1:8080/mcp
  KAIROS_TOKEN          A8 토큰. 없으면 KAIROS_TOKEN_FILE, 그것도 없으면
  KAIROS_TOKEN_FILE     기본 ~/.config/kairos/token. 같은 호스트에서는 없어도 된다
                        (게이트웨이의 루프백 면제)
  KAIROS_AUTO_ARCHIVE   1이면 턴마다 자동 보관 (기본 꺼짐)
  KAIROS_ARCHIVE_STATE  상태 디렉토리. 기본 $XDG_STATE_HOME/kairos/archive

보내는 것: 요청마다 `X-KAIROS-Client: claude-code` 헤더(인입 경로 표식 — 인증이 아니다,
decisions.md §106). 값은 고정이고 설정으로 바꾸지 않는다.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_URL = "http://127.0.0.1:8080/mcp"
DEFAULT_TOKEN_FILE = "~/.config/kairos/token"

# 분당 상한 60(`[gateway].mcp_write_rate_per_min`)보다 낮게 잡는다 — 같은 창을 쓰는
# 다른 클라이언트가 있을 수 있고, 상한에 딱 붙이면 그쪽이 굶는다.
DEFAULT_RATE_PER_MIN = 45

# 세션 하나에서 한 번에 보낼 턴 수의 상한. 재생이 통째로 몇십 분을 잡아먹지 않도록.
# 넘친 것은 다음 실행이 이어서 보낸다(상태 파일이 이어가는 자리를 안다).
DEFAULT_MAX_TURNS = 500
# 인입 경로 표식(A2 `client`). 어느 클라이언트의 대화록인지는 `--client`가 정하고 main()이
# 여기에 적는다 — 헤더와 세션 접두어가 같은 값을 본다(decisions.md §106·§127)
CLIENT_NAME = "claude-code"

RATE_LIMIT_HINT = "분당"

# Claude Code 대화록 위치 — 프로젝트 경로의 `/`를 `-`로 바꾼 것이 디렉토리 이름이다
# (실측 2026-09-04: /home/u/Workspace/kairos → -home-u-Workspace-kairos).
CLAUDE_PROJECTS = "~/.claude/projects"


# --- 대화록 → 턴 --------------------------------------------------------------------

def _texts(content) -> str:
    """메시지 content에서 **사람이 읽는 텍스트만** 꺼낸다.

    `thinking`은 답변이 아니라 내부 추론이고, `tool_use`·`tool_result`는 도구 입출력이라
    둘 다 대화의 지식이 아니다. 문자열 content는 그대로가 본문이다.
    """
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n\n".join(b.get("text", "") for b in content
                           if isinstance(b, dict) and b.get("type") == "text")
    return ""


def turns_claude_code(path: Path) -> list[dict]:
    """Claude Code 대화록(JSONL) → 턴 목록. 실측 2026-09-04.

    한 턴 = 사람이 친 프롬프트 하나 + 다음 프롬프트 전까지의 어시스턴트 텍스트 전부.
    **부수 대화(`isSidechain`)는 제외한다** — 서브에이전트의 대화라 사람이 나눈 것이
    아니고, 본 대화의 답변에 이미 요약되어 들어 있다.
    """
    turns: list[dict] = []
    current: dict | None = None
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue                       # 쓰는 중에 잘린 마지막 줄 — 다음 실행이 본다
        if not isinstance(rec, dict) or rec.get("isSidechain"):
            continue
        kind = rec.get("type")
        message = rec.get("message") or {}
        if kind == "user":
            # 허용 목록: `origin.kind == "human"`인 것만이 사람이 실제로 친 프롬프트다.
            # 슬래시 명령 출력·bash 입출력·도구 결과는 전부 이 표시가 없다.
            if (rec.get("origin") or {}).get("kind") != "human" or rec.get("isMeta"):
                continue
            question = _texts(message.get("content")).strip()
            if not question:
                continue
            current = {"question": question, "captured_at": rec.get("timestamp") or "",
                       "answer": []}
            turns.append(current)
        elif kind == "assistant" and current is not None:
            answer = _texts(message.get("content")).strip()
            if answer:
                current["answer"].append(answer)
    out = []
    for turn in turns:
        if not turn["answer"]:
            continue                       # 답변이 없는 프롬프트(중단·취소)는 지식이 아니다
        out.append({"question": turn["question"], "captured_at": turn["captured_at"],
                    "content": "\n\n".join(turn["answer"])})
    return out


def session_id_claude_code(hook: dict, path: Path) -> str:
    """`claude:<세션 uuid>` — 클라이언트 이름을 앞에 붙여 세션 충돌을 막는다.

    무해화는 서버의 `paths.safe_session_id`가 하므로 여기서는 붙이기만 한다.
    """
    return "claude:" + str(hook.get("session_id") or path.stem)


def project_slug(project_dir: str) -> str:
    """프로젝트 경로 → 대화록 디렉토리 이름. Claude Code의 규칙을 그대로 따른다."""
    return re.sub(r"[/\\]", "-", str(Path(project_dir).expanduser().resolve()))


def latest_transcript(project_dir: str, projects_root: str = CLAUDE_PROJECTS) -> Path | None:
    """이 프로젝트의 가장 최근 대화록 — `/kairos:archive`가 "지금 이 대화"를 찾는 길.

    가장 최근에 **쓰인** 파일이 지금 진행 중인 세션이다. 이름(uuid)에는 순서가 없다.
    """
    base = Path(projects_root).expanduser() / project_slug(project_dir)
    if not base.is_dir():
        return None
    files = sorted(base.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return files[0] if files else None


# --- Codex CLI (decisions.md §127) ------------------------------------------------------
# 대화록은 `~/.codex/sessions/YYYY/MM/DD/rollout-<시각>-<uuid>.jsonl`이고 한 줄은
# `{"timestamp", "type", "payload"}`다. 사람이 친 글은 `event_msg`의 `user_message`, 답변은
# `event_msg`의 `agent_message`(phase가 commentary면 중간 서술이라 뺀다)로 실린다.
# `response_item`(도구 호출·출력, 개발자 지시, 환경 문맥)·`turn_context`·`compacted`는
# 대화가 아니므로 허용 목록 밖이다 — Claude Code 어댑터와 같은 원칙이다.
CODEX_SESSIONS = "~/.codex/sessions"


def _codex_line(rec: dict) -> tuple[str, dict]:
    payload = rec.get("payload")
    return str(rec.get("type") or ""), (payload if isinstance(payload, dict) else {})


def _is_injected(text: str) -> bool:
    """`<environment_context>`·`<user_instructions>`처럼 Codex가 끼워 넣는 XML 꼴은 사람의 글이 아니다."""
    head = text.lstrip().split("\n", 1)[0]
    return head.startswith("<") and ">" in head


def turns_codex(path: Path) -> list[dict]:
    """Codex 롤아웃(JSONL) → 턴 목록. 한 턴 = user_message 하나 + 다음 것 전까지의 agent_message 전부."""
    turns: list[dict] = []
    current: dict | None = None
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue                       # 쓰는 중에 잘린 마지막 줄
        if not isinstance(rec, dict):
            continue
        kind, payload = _codex_line(rec)
        if kind == "event_msg" and payload.get("type") == "user_message":
            question = str(payload.get("message") or "").strip()
            if not question or _is_injected(question):
                continue
            current = {"question": question, "captured_at": rec.get("timestamp") or "",
                       "answer": [], "fallback": []}
            turns.append(current)
        elif current is None:
            continue
        elif kind == "event_msg" and payload.get("type") == "agent_message":
            if payload.get("phase") == "commentary":
                continue                   # 중간 서술 — 최종 답변이 따로 온다
            answer = str(payload.get("message") or "").strip()
            if answer:
                current["answer"].append(answer)
        elif (kind == "response_item" and payload.get("type") == "message"
              and payload.get("role") == "assistant"):
            # 이벤트가 기록되지 않는 판(옛 CLI)을 위한 예비 — 이벤트가 있으면 쓰지 않는다
            text = "\n\n".join(str(c.get("text", "")) for c in payload.get("content") or []
                                if isinstance(c, dict) and c.get("type") == "output_text").strip()
            if text:
                current["fallback"].append(text)
    out = []
    for turn in turns:
        answers = turn["answer"] or turn["fallback"]
        if not answers:
            continue                       # 답변이 없는 프롬프트는 지식이 아니다
        out.append({"question": turn["question"], "captured_at": turn["captured_at"],
                    "content": "\n\n".join(answers)})
    return out


def _codex_meta(path: Path) -> dict:
    """첫 줄의 `session_meta` payload — 세션 id와 작업 디렉터리(cwd)가 여기 있다."""
    try:
        with path.open(encoding="utf-8", errors="replace") as f:
            rec = json.loads(f.readline() or "{}")
    except (OSError, ValueError):
        return {}
    kind, payload = _codex_line(rec) if isinstance(rec, dict) else ("", {})
    return payload if kind == "session_meta" else {}


def session_id_codex(hook: dict, path: Path) -> str:
    """`codex:<세션 id>` — 훅이 주면 그것, 아니면 롤아웃 첫 줄, 그것도 없으면 파일 이름."""
    sid = hook.get("session_id") or _codex_meta(path).get("id") or path.stem
    return "codex:" + str(sid)


def latest_transcript_codex(project_dir: str, sessions_root: str = CODEX_SESSIONS) -> Path | None:
    """이 프로젝트의 가장 최근 롤아웃 — Codex는 프로젝트별 디렉터리가 없어 `session_meta.cwd`로 고른다.

    최근에 쓰인 파일부터 첫 줄만 읽으므로 세션이 많아도 비용은 파일 수에 비례한다.
    압축된 옛 롤아웃(`.jsonl.zst`)은 보지 않는다 — 지금 진행 중인 세션은 늘 평문이다.
    """
    root = Path(sessions_root).expanduser()
    if not root.is_dir():
        return None
    target = str(Path(project_dir).expanduser().resolve())
    files = sorted(root.glob("**/rollout-*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for path in files:
        if str(_codex_meta(path).get("cwd") or "") == target:
            return path
    return None


# 이름 → (대화록 → 턴, 세션 id, 프로젝트 → 최근 대화록). 셋이 한 벌이어야 `--client` 하나로 갈린다.
ADAPTERS = {
    "claude-code": (turns_claude_code, session_id_claude_code, latest_transcript),
    "codex": (turns_codex, session_id_codex, latest_transcript_codex),
}


# --- 상태 (증분 전송) ---------------------------------------------------------------

def state_dir() -> Path:
    base = os.environ.get("KAIROS_ARCHIVE_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
        "kairos", "archive")
    return Path(base).expanduser()


def state_path(session_id: str) -> Path:
    safe = re.sub(r"[^\w.\-]", "_", session_id)[:120]
    return state_dir() / f"{safe}.json"


def load_state(session_id: str) -> int:
    """마지막으로 보낸 턴 번호. 재전송은 삼중 대조로 무해하지만 분당 창을 낭비한다."""
    try:
        return int(json.loads(state_path(session_id).read_text(encoding="utf-8"))["last_turn"])
    except (OSError, ValueError, KeyError, TypeError):
        return 0


def save_state(session_id: str, last_turn: int) -> None:
    path = state_path(session_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"last_turn": last_turn}), encoding="utf-8")
    tmp.replace(path)                      # 원자적 — 중간에 죽어도 상태가 깨지지 않는다


# --- MCP 클라이언트 -----------------------------------------------------------------

class Client:
    """Streamable HTTP stateless — `initialize` 왕복이 필요 없다(서버가 stateless)."""

    def __init__(self, url: str, token: str, rate_per_min: int) -> None:
        self.url = url
        self.token = token
        self.interval = 60.0 / max(1, rate_per_min)
        self._next_at = 0.0
        self._id = 0

    def call(self, name: str, arguments: dict) -> dict:
        for attempt in range(6):
            self._pace()
            try:
                result = self._post(name, arguments)
            except urllib.error.HTTPError as e:
                if e.code in (429, 503) and attempt < 5:
                    self._backoff(attempt)
                    continue
                body = e.read().decode("utf-8", "replace")[:200]
                raise SystemExit(f"HTTP {e.code} — {body}") from e
            if not result.get("isError"):
                return result
            text = _error_text(result)
            if RATE_LIMIT_HINT in text and attempt < 5:
                self._backoff(attempt)      # 쓰기 한도 — 기다렸다 다시 (계획서 §3.5-2)
                continue
            raise SystemExit(f"{name} 실패: {text}")
        raise SystemExit(f"{name}: 쓰기 한도가 풀리지 않는다 — 나중에 다시 실행한다")

    def rpc(self, method: str, params: dict | None = None) -> dict:
        """툴 호출이 아닌 일반 JSON-RPC — `status`가 `tools/list`를 부를 때 쓴다."""
        self._id += 1
        body = json.dumps({"jsonrpc": "2.0", "id": self._id, "method": method,
                           **({"params": params} if params else {})}).encode()
        req = urllib.request.Request(self.url, data=body, method="POST", headers={
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            # 어느 클라이언트에서 왔는가 — 서버가 이 헤더로 노트에 경로를 적는다.
            # 인증이 아니라 분류다(플러그인 `.mcp.json`도 같은 헤더를 싣는다)
            "X-KAIROS-Client": CLIENT_NAME,
            **({"Authorization": f"Bearer {self.token}"} if self.token else {})})
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.loads(resp.read().decode("utf-8"))

    def _post(self, name: str, arguments: dict) -> dict:
        payload = self.rpc("tools/call", {"name": name, "arguments": arguments})
        if "error" in payload:
            raise SystemExit(f"{name}: {payload['error'].get('message', payload['error'])}")
        return payload.get("result") or {}

    def _pace(self) -> None:
        wait = self._next_at - time.monotonic()
        if wait > 0:
            time.sleep(wait)
        self._next_at = time.monotonic() + self.interval

    def _backoff(self, attempt: int) -> None:
        time.sleep(min(60.0, 5.0 * (2 ** attempt)))


def _error_text(result: dict) -> str:
    return " ".join(c.get("text", "") for c in result.get("content", [])
                    if isinstance(c, dict))


def read_token() -> tuple[str, str]:
    """`(토큰, 출처)`. 없으면 빈 토큰 — 같은 호스트는 루프백 면제로 붙는다(A8)."""
    token = os.environ.get("KAIROS_TOKEN")
    if token:
        return token.strip(), "KAIROS_TOKEN"
    path = Path(os.environ.get("KAIROS_TOKEN_FILE") or DEFAULT_TOKEN_FILE).expanduser()
    try:
        return path.read_text(encoding="utf-8").strip(), str(path)
    except OSError:
        return "", "(없음 — 같은 호스트의 루프백 면제에 기댄다)"


def gateway_url() -> str:
    return os.environ.get("KAIROS_URL", DEFAULT_URL)


# --- 집행 -------------------------------------------------------------------------

def archive(transcript: Path, session_id: str, client_name: str, *,
            dry_run: bool, finalize: bool, max_turns: int,
            url: str, rate: int) -> int:
    to_turns, _, _ = ADAPTERS[client_name]
    turns = to_turns(transcript)
    sent_through = load_state(session_id)
    pending = [(i + 1, t) for i, t in enumerate(turns) if i + 1 > sent_through]

    if not pending:
        _log(f"{session_id}: 보낼 턴 없음 (턴 {len(turns)}, 이미 {sent_through}까지 보냄)")
        if finalize and not dry_run and sent_through:
            _client(url, rate).call("finalize_session", {"session_id": session_id})
        return 0

    capped = pending[:max_turns]
    if len(capped) < len(pending):          # 잘랐으면 말한다 — 조용한 절단은 거짓말이다
        _log(f"{session_id}: 대기 {len(pending)}턴 중 {len(capped)}턴만 보낸다 "
             f"(--max-turns). 나머지는 다음 실행이 이어서 보낸다")

    if dry_run:
        for turn_no, turn in capped:
            _log(f"  [{turn_no}] {turn['captured_at']} q={turn['question'][:60]!r} "
                 f"a={len(turn['content']):,}자")
        _log(f"{session_id}: {len(capped)}턴 (전송하지 않음)")
        return len(capped)

    client = _client(url, rate)
    sent = 0
    for turn_no, turn in capped:
        client.call("archive_turn", {
            "session_id": session_id, "turn_no": turn_no,
            "content": turn["content"], "question": turn["question"],
            "captured_at": turn["captured_at"]})
        # **턴마다 즉시 기록한다.** 마지막에 한 번 쓰면 중간에 죽었을 때 전부 다시 보낸다.
        save_state(session_id, turn_no)
        sent += 1
    if finalize:
        client.call("finalize_session", {"session_id": session_id})
    _log(f"{session_id}: {sent}턴 전송{' + 마감' if finalize else ''}")
    return sent


def finalize_only(session_id: str, url: str, rate: int) -> bool:
    """세션 종료 훅 — 보낸 적이 있는 세션만 마감한다. 보낸 적 없으면 서버에 행도 없다."""
    if not load_state(session_id):
        return False
    _client(url, rate).call("finalize_session", {"session_id": session_id})
    _log(f"{session_id}: 마감")
    return True


def auto_archive_enabled() -> bool:
    return os.environ.get("KAIROS_AUTO_ARCHIVE", "").strip().lower() in ("1", "true", "yes", "on")


def status_report(url: str, project_dir: str | None, client_name: str = "claude-code") -> list[str]:
    """`/kairos:status`가 보이는 것 — **붙었는가, 무엇으로, 무엇이 켜져 있는가**.

    실패는 사유를 문장으로 말한다. "연결 안 됨" 한 줄은 다음에 무엇을 할지 말해 주지 않는다.
    """
    token, source = read_token()
    lines = [f"게이트웨이  {url}", f"토큰        {source}"]
    try:
        payload = Client(url, token, 600).rpc("tools/list")
        tools = [t["name"] for t in payload.get("result", {}).get("tools", [])]
        lines.append(f"연결        됨 — 툴 {len(tools)}종 ({', '.join(tools[:4])}…)")
    except urllib.error.HTTPError as e:
        why = ("토큰이 없거나 틀렸다 — LAN에서는 KAIROS_TOKEN이 필요하다"
               if e.code == 401 else f"HTTP {e.code}")
        lines.append(f"연결        실패 — {why}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        lines.append(f"연결        실패 — 게이트웨이에 닿지 않는다 ({e}). "
                     "서버에서 `systemctl --user status kairos-gateway`")
    lines.append(f"자동 보관   {'켜짐 (KAIROS_AUTO_ARCHIVE)' if auto_archive_enabled() else '꺼짐 — 명시 보관은 /kairos:archive'}")
    if project_dir:
        _, to_session, find = ADAPTERS[client_name]
        t = find(project_dir)
        if t is None:
            lines.append("이 프로젝트  대화록 없음")
        else:
            sid = to_session({}, t)
            lines.append(f"이 프로젝트  대화록 {t.name} · 보낸 턴 {load_state(sid)}")
    return lines


def _client(url: str, rate: int) -> Client:
    return Client(url, read_token()[0], rate)


def _log(message: str) -> None:
    print(message, file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="kairos-client",
                                     description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="mode", required=True)

    hook = sub.add_parser("hook", help="에이전트 CLI 훅(Claude Code·Codex) — stdin으로 훅 JSON을 받는다")
    hook.add_argument("event", choices=["stop", "end"],
                      help="stop: 새 턴 전송(자동 보관이 켜졌을 때만) · end: 마감")

    replay = sub.add_parser("replay", help="대화록을 보낸다 (명시 보관)")
    replay.add_argument("--transcript", type=Path, help="대화록 파일")
    replay.add_argument("--project", help="이 프로젝트의 최근 대화록을 고른다")
    replay.add_argument("--session-id")
    replay.add_argument("--max-turns", type=int, default=DEFAULT_MAX_TURNS)
    replay.add_argument("--dry-run", action="store_true")
    replay.add_argument("--no-finalize", action="store_true")

    status = sub.add_parser("status", help="연결·토큰·훅 상태")
    status.add_argument("--project")

    for p in (hook, replay, status):
        p.add_argument("--client", default="claude-code", choices=sorted(ADAPTERS))
        p.add_argument("--url", default=gateway_url())
        p.add_argument("--rate", type=int, default=DEFAULT_RATE_PER_MIN)
    args = parser.parse_args(argv)

    global CLIENT_NAME
    CLIENT_NAME = args.client                # 헤더(X-KAIROS-Client)와 세션 접두어가 같은 값을 본다

    if args.mode == "status":
        print("\n".join(status_report(args.url, args.project, args.client)))
        return 0

    _, to_session, find = ADAPTERS[args.client]

    if args.mode == "hook":
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            return 0                        # 훅은 에이전트를 막지 않는다
        transcript = Path(str(payload.get("transcript_path") or ""))
        session_id = to_session(payload, transcript)
        if args.event == "end":
            finalize_only(session_id, args.url, args.rate)
            return 0
        if not auto_archive_enabled():
            return 0                        # 11-B-2 — 기본은 보내지 않는다. /kairos:status가 말해 준다
        if not transcript.is_file():
            return 0
        archive(transcript, session_id, args.client, dry_run=False, finalize=False,
                max_turns=DEFAULT_MAX_TURNS, url=args.url, rate=args.rate)
        return 0

    transcript = args.transcript
    if transcript is None and args.project:
        transcript = find(args.project)
        if transcript is None:
            _log(f"이 프로젝트의 대화록이 없다: {args.project}")
            return 1
    if transcript is None:
        replay.error("--transcript 또는 --project가 필요하다")
    if not transcript.is_file():
        _log(f"대화록을 찾지 못했다: {transcript}")
        return 1
    session_id = args.session_id or to_session({}, transcript)
    archive(transcript, session_id, args.client, dry_run=args.dry_run,
            finalize=not args.no_finalize, max_turns=args.max_turns,
            url=args.url, rate=args.rate)
    return 0


if __name__ == "__main__":
    sys.exit(main())
