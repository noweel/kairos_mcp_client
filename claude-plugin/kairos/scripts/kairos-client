#!/bin/sh
# kairos-client 진입점 — 옆의 kairos-client.py를 돌릴 파이썬을 고른다.
#
# 본체에 `#!/usr/bin/env python3`를 박아 두면 Windows에서 깨진다. python.org 설치본에는
# python3.exe가 없어서 `python3`이 마이크로소프트 스토어 스텁(WindowsApps)으로 풀리고,
# 그 스텁이 "Python was not found"를 찍으며 죽는다(실측 2026-09-13). 스텁은 `-c`도
# 실패하므로, 실제로 실행되는 후보를 순서대로 찾아 그것으로 넘긴다.
here=$(dirname "$0")
for py in python3 python "py -3"; do
    if $py -c 'import sys' >/dev/null 2>&1; then
        exec $py "$here/kairos-client.py" "$@"
    fi
done
echo "kairos-client: python3 를 찾지 못했다 (python3 · python · py -3 모두 실행 불가)" >&2
exit 1
