# KAIROS systemd 유닛 공통 환경 — `~/.config/kairos/kairos.env`로 복사해 고친다.
#
# 유닛 파일에 경로를 박지 않는 이유: 설치 환경마다 다르고, 바뀔 때 유닛 5개를
# 전부 고치게 되기 때문이다. 바뀌는 값은 여기 한 곳에 둔다.

# 파이썬 환경의 bin 디렉터리 (kairos·vllm·uvicorn이 있는 곳)
KAIROS_BIN=/home/YOU/miniforge3/envs/work/bin

# 데이터 루트 — vault·index.db·queue.db가 사는 곳 (git 저장고도 여기 아래)
KAIROS_ROOT=/home/YOU/kairos-data

# 상시 텍스트 모델 (기획서 §7.1 — 티어별 설정값. 코어는 이 값을 모른다)
# **모델과 서빙 옵션은 한 쌍으로 기록한다**: 구조화 출력 안정성이 모델만의 성질이
# 아니라 서빙 설정과의 조합이라서다. 모델을 바꾸면 아래 전부를 함께 본다.
KAIROS_TEXT_MODEL=/home/YOU/models/qwen3.8-27b-nvfp4/model
KAIROS_TEXT_MODEL_NAME=qwen3.8-27b
KAIROS_TEXT_MAX_LEN=242000
KAIROS_TEXT_GPU_UTIL=0.96
KAIROS_TEXT_KV_DTYPE=fp8
KAIROS_TEXT_COMPILE={"cudagraph_mode": "FULL_DECODE_ONLY", "cudagraph_capture_sizes": [1, 2, 4]}
# 사고 모드 — 켜면 느려지고 출력이 달라진다. 32GB 티어 실측은 끈 상태의 값이다.
KAIROS_TEXT_CHAT_KWARGS={"enable_thinking": false}
# xgrammar 공백 금지: 구조화 출력 중 공백 무한 생성을 막는다(decisions.md §41)
KAIROS_TEXT_STRUCTURED={"backend":"xgrammar","disable_any_whitespace":true}

# 온디맨드 VLM (§7.1). 메인 모델이 비전을 겸하는 티어에서는 이 유닛을 쓰지 않고
# config에 `[llm.backend] vlm_describe = "local"`을 둔다 — 스왑 0.
KAIROS_VLM_MODEL=/home/YOU/models/vlm/model
KAIROS_VLM_MODEL_NAME=vlm

# 임베딩 서버 (BGE-M3, CPU). 비우면 캐시(~/.cache/kairos/bge-m3)에 내려받는다.
KAIROS_EMBED_MODEL=
KAIROS_EMBED_THREADS=16
