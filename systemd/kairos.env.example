# KAIROS systemd 유닛 공통 환경 — `~/.config/kairos/kairos.env`로 복사해 고친다.
#
# 유닛 파일에 경로를 박지 않는 이유: 설치 환경마다 다르고, 바뀔 때 유닛 5개를
# 전부 고치게 되기 때문이다. 바뀌는 값은 여기 한 곳에 둔다.

# 파이썬 환경의 bin 디렉터리 (kairos·vllm·uvicorn이 있는 곳)
KAIROS_BIN=/home/YOU/miniforge3/envs/work/bin

# **PATH도 함께 준다**(2026-09-08 실측). 유닛은 절대 경로로 실행 파일을 부르므로 평소에는
# PATH가 없어도 돌지만, vLLM이 커널을 **처음 컴파일할 때** 부르는 `ninja`는 PATH에서 찾는다.
# 컴파일 캐시가 남아 있는 동안에는 드러나지 않다가, 캐시를 지우면
# `FileNotFoundError: No such file or directory: 'ninja'`로 기동이 실패한다.
PATH=/home/YOU/miniforge3/envs/work/bin:/usr/local/cuda-13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 데이터 루트 — vault·index.db·queue.db가 사는 곳 (git 저장고도 여기 아래)
KAIROS_ROOT=/home/YOU/kairos-data

# 상시 텍스트 모델 (기획서 §7.1 — 티어별 설정값. 코어는 이 값을 모른다)
# **모델과 서빙 옵션은 한 쌍으로 기록한다**: 구조화 출력 안정성이 모델만의 성질이
# 아니라 서빙 설정과의 조합이라서다. 모델을 바꾸면 아래 전부를 함께 본다.
# 32GB 티어: 어텐션까지 NVFP4인 QAT 체크포인트(QUASAR-QAT/Qwen3.8-27B-QUASAR-NVFP4, decisions.md §187).
# served model id가 `normalized_by` 스탬프가 되므로 체크포인트를 바꾸면 이름도 바꾼다(교체 전후 노트를 가르기 위해).
KAIROS_TEXT_MODEL=/home/YOU/models/qwen3.8-27b-quasar-nvfp4/model
KAIROS_TEXT_MODEL_NAME=qwen3.8-27b-quasar
# 최대 문맥 길이는 **KV 캐시가 실제로 얼마나 남는가**에 걸린다(decisions.md §145·§187).
# 위 체크포인트는 가중치가 작아 262144에서도 KV 8.41GiB(1.02배)가 남는다(2026-09-14 유닛 실측).
# 여유가 작으니 원격 데스크톱 같은 다른 GPU 사용자가 늘어 기동이 실패하면 이 값을 내린다.
# 어텐션이 FP8인 체크포인트(RadixArk/Qwen3.8-27B-NVFP4)는 242000도 가용분 7.1~7.3GiB를 넘어 실패했다 — 그때는 200000.
# Normalizer는 이 값을 vLLM에서 조회해 상한으로 삼는다(§117).
KAIROS_TEXT_MAX_LEN=262144
KAIROS_TEXT_GPU_UTIL=0.96
KAIROS_TEXT_KV_DTYPE=fp8
KAIROS_TEXT_COMPILE={"cudagraph_mode": "FULL_DECODE_ONLY", "cudagraph_capture_sizes": [1, 2, 4]}
# 사고 모드 — 켜면 느려지고 출력이 달라진다. 32GB 티어 실측은 끈 상태의 값이다.
KAIROS_TEXT_CHAT_KWARGS={"enable_thinking": false}
# xgrammar 공백 금지: 구조화 출력 중 공백 무한 생성을 막는다(decisions.md §41)
KAIROS_TEXT_STRUCTURED={"backend":"xgrammar","disable_any_whitespace":true}

# 온디맨드 VLM (§7.1). 메인 모델이 비전을 겸하는 티어에서는 이 유닛을 쓰지 않고
# config에 `[llm.backend] vlm_describe = "local"`을 둔다 — 스왑 0.
KAIROS_VLM_MODEL=/home/YOU/models/vlm/model
KAIROS_VLM_MODEL_NAME=vlm

# Telegram 봇 토큰 (README §9, 선택). 시크릿이라 config.toml이 아니라 여기(0600)에 둔다.
# 화이트리스트 user_id는 config.toml의 [telegram].allowed_user_id다.
KAIROS_TG_TOKEN=

# 임베딩 서버 (BGE-M3, CPU). 비우면 캐시(~/.cache/kairos/bge-m3)에 내려받는다.
KAIROS_EMBED_MODEL=
KAIROS_EMBED_THREADS=16
