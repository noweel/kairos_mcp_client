[Unit]
Description=KAIROS 상시 텍스트 모델 (vLLM)
Documentation=file:///deploy/README.md
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/kairos/kairos.env
# **모델과 서빙 옵션은 한 쌍이다**(기획서 §7.1) — 구조화 출력 안정성이 모델만의 성질이
# 아니라 서빙 설정과의 조합이기 때문이다. 그래서 티어로 정해지는 값은 전부 모델 경로와
# **같은 파일**(kairos.env)에 둔다. 여기 남는 것은 티어와 무관한 둘뿐이다.
#
# JSON 값은 공백을 포함할 수 있어 반드시 큰따옴표로 감싼다 — 안 그러면 sh가 쪼개
# 인자 여러 개가 되고, vLLM은 알 수 없는 인자로 죽는다.
ExecStart=/bin/sh -c 'exec "$KAIROS_BIN/vllm" serve "$KAIROS_TEXT_MODEL" \
  --served-model-name "$KAIROS_TEXT_MODEL_NAME" \
  --max-model-len "$KAIROS_TEXT_MAX_LEN" \
  --gpu-memory-utilization "$KAIROS_TEXT_GPU_UTIL" \
  --kv-cache-dtype "$KAIROS_TEXT_KV_DTYPE" \
  --compilation-config "$KAIROS_TEXT_COMPILE" \
  --default-chat-template-kwargs "$KAIROS_TEXT_CHAT_KWARGS" \
  --structured-outputs-config "$KAIROS_TEXT_STRUCTURED" \
  --max-num-seqs 1 \
  --host 127.0.0.1 --port 8000'
# `--max-num-seqs 1`은 티어값이 아니라 KAIROS의 결정이다 — 동시 요청 제한은 수신기가
# 결정적으로 제어한다(기획서 §7.1). Normalizer의 출력 상한 근거도 이 값에 걸려 있다.
Restart=on-failure
RestartSec=10
# 적재가 수 분 걸린다 — 짧으면 기동 중에 죽는다
TimeoutStartSec=600

[Install]
WantedBy=default.target
